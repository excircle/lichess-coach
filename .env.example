# Copy to .env and fill in. `.env` is git-ignored — never commit it.

# Claude Max subscription token — generate on the HOST with: claude setup-token
# NEVER set ANTHROPIC_API_KEY here: it would outrank this token and bill the
# pay-per-token API instead of the Max subscription.
CLAUDE_CODE_OAUTH_TOKEN=

# Lichess OAuth PKCE needs no app registration; any unique client id works.
LICHESS_CLIENT_ID=lichess-coach.alexander.local

# iron-session cookie encryption — 32+ random chars, e.g.: openssl rand -hex 32
SESSION_SECRET=

# Where the browser reaches the app (OAuth redirect base).
APP_URL=http://localhost:3000

# In-container paths (match docker-compose volumes).
DATABASE_PATH=/data/coach.db
STOCKFISH_PATH=/usr/games/stockfish

# Claude models for live coaching / post-game review.
COACH_MODEL=sonnet
REVIEW_MODEL=sonnet

# Optional: personal access token fallback for scripts/spike-stream.ts
# (normally the spike uses the token the in-app OAuth login stored in the DB).
# Create at https://lichess.org/account/oauth/token with scopes: challenge:write board:play
#LICHESS_PAT=
